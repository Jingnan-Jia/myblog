{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/feishu/:path*",
      "destination": "/api/feishu"
    },
    {
      "source": "/api/academic/:path*",
      "destination": "/api/academic"
    },
    {
      "source": "/agents/:path*",
      "destination": "/agents/demo/index.html"
    }
  ],
  "functions": {
    "api/feishu/index.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/academic/index.js": {
      "memory": 256,
      "maxDuration": 30
    }
  }
}