---
// 成果导出通道 — 独立工具单页（不套 Layout、不进站点导航）
// 密码门复用 guestbook 的 sha256 注入模式：PUBLIC_EXPORT_PASSWORD_HASH = sha256(口令)
// 口令与 Vercel RELAY_SECRET 同源：网页 web_token = sha256(口令)，服务端比对 sha256(RELAY_SECRET)
import "@/styles/global.css";

const PASSWORD_HASH: string = (import.meta.env.PUBLIC_EXPORT_PASSWORD_HASH as string | undefined) ?? "";
const DEFAULT_OWNER: string = (import.meta.env.PUBLIC_EXPORT_DEFAULT_OWNER as string | undefined) ?? "";
const DEFAULT_BRANCH: string =
  (import.meta.env.PUBLIC_EXPORT_DEFAULT_BRANCH as string | undefined) || "main";
const CONFIGURED = PASSWORD_HASH.length > 0;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>成果导出通道</title>
    <style>
      html {
        font-family: "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
      }
      @keyframes shake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-6px); }
        75% { transform: translateX(6px); }
      }
      .shake { animation: shake 0.3s ease-in-out; }
      @keyframes pulse-dot {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.4; }
      }
      .pulse-dot { animation: pulse-dot 1.6s ease-in-out infinite; }
    </style>
  </head>
  <body class="min-h-screen bg-[#F6F7FB] text-[#1F2937] antialiased">
    <!-- 顶栏 -->
    <header class="sticky top-0 z-10 border-b border-[#E5E7EB] bg-white/80 backdrop-blur">
      <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-3">
        <div class="flex items-center gap-2.5">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-indigo-600 via-indigo-500 to-cyan-400 text-sm font-bold text-white">
            E
          </span>
          <div>
            <h1 class="text-lg font-semibold leading-tight">成果导出通道</h1>
            <p class="text-xs text-[#6B7280]">经批准的临时中转 · 整批单 commit 写入 GitHub 私有仓库</p>
          </div>
        </div>
        <div class="flex items-center gap-1.5 text-xs text-[#6B7280]">
          <span id="status-dot" class="h-2 w-2 rounded-full bg-emerald-500 pulse-dot"></span>
          <span id="status-text">就绪</span>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-3xl space-y-4 px-4 py-6">
      {
        !CONFIGURED && (
          <section class="rounded-xl border border-amber-200 bg-amber-50 p-5 text-sm leading-relaxed text-amber-800">
            <p class="mb-1 font-medium">该功能尚未完成部署配置</p>
            <p>
              管理员请按 <code class="rounded bg-amber-100 px-1">docs/export-pipeline.md</code> 在 Vercel
              配置 <code class="rounded bg-amber-100 px-1">EXPORT_RELAY_SECRET</code>（或沿用
              <code class="rounded bg-amber-100 px-1">RELAY_SECRET</code>）与构建环境变量
              <code class="rounded bg-amber-100 px-1">PUBLIC_EXPORT_PASSWORD_HASH</code>（同一口令的 sha256，配好后重新部署）。
            </p>
          </section>
        )
      }

      <!-- 1) 密码门 -->
      <section id="gate-card" class="rounded-xl border border-[#E5E7EB] bg-white p-8 shadow-sm">
        <div class="mx-auto max-w-xs text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-indigo-50">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
            </svg>
          </div>
          <h2 class="mb-1 text-base font-semibold">访问验证</h2>
          <p class="mb-4 text-xs text-[#6B7280]">输入导出口令以解锁上传界面</p>
          <input
            id="gate-password"
            type="password"
            placeholder="导出口令"
            autocomplete="off"
            class="w-full rounded-lg border border-[#E5E7EB] bg-[#F6F7FB] px-3 py-2 text-sm outline-none transition focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100"
          />
          <button
            id="gate-submit"
            class="mt-3 w-full rounded-lg bg-gradient-to-r from-indigo-600 to-indigo-500 px-4 py-2 text-sm font-medium text-white shadow-sm transition hover:opacity-90 active:scale-[0.99] disabled:cursor-not-allowed disabled:opacity-50"
          >
            解锁
          </button>
          <p id="gate-error" class="mt-2 hidden text-xs text-red-500">口令不正确，请重试</p>
        </div>
      </section>

      <!-- 2) 会话设置 -->
      <section id="session-card" class="hidden rounded-xl border border-[#E5E7EB] bg-white p-5 shadow-sm">
        <h2 class="mb-3 text-[15px] font-medium text-[#1F2937]">本次导出会话</h2>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <label class="block">
            <span class="mb-1 block text-xs text-[#6B7280]">项目标签（可选，写入 commit message）</span>
            <input id="f-label" type="text" placeholder="如 exp-A-batch1" class="w-full rounded-lg border border-[#E5E7EB] px-3 py-2 text-sm outline-none transition focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100" />
          </label>
          <label class="block">
            <span class="mb-1 block text-xs text-[#6B7280]">GitHub owner</span>
            <input id="f-owner" type="text" placeholder="用户名" class="w-full rounded-lg border border-[#E5E7EB] px-3 py-2 text-sm outline-none transition focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100" />
          </label>
          <label class="block">
            <span class="mb-1 block text-xs text-[#6B7280]">仓库名（需预先手工建好）</span>
            <input id="f-repo" type="text" placeholder="私有仓库名" class="w-full rounded-lg border border-[#E5E7EB] px-3 py-2 text-sm outline-none transition focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100" />
          </label>
          <label class="block">
            <span class="mb-1 block text-xs text-[#6B7280]">分支</span>
            <input id="f-branch" type="text" placeholder="main" class="w-full rounded-lg border border-[#E5E7EB] px-3 py-2 text-sm outline-none transition focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100" />
          </label>
          <label class="block sm:col-span-2">
            <span class="mb-1 block text-xs text-[#6B7280]">仓库内子目录（可选，留空则落仓库根）</span>
            <input id="f-subdir" type="text" placeholder="如 results/v2（留空 = 仓库根）" class="w-full rounded-lg border border-[#E5E7EB] px-3 py-2 text-sm outline-none transition focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100" />
          </label>
        </div>
        <p id="session-hint" class="mt-3 hidden rounded-lg bg-[#F6F7FB] px-3 py-2 font-mono text-xs text-[#6B7280]"></p>
        <button id="session-start" class="mt-3 rounded-lg bg-gradient-to-r from-indigo-600 to-indigo-500 px-4 py-2 text-sm font-medium text-white shadow-sm transition hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50">
          开始添加内容
        </button>
      </section>

      <!-- 3) 内容添加 -->
      <section id="files-card" class="hidden rounded-xl border border-[#E5E7EB] bg-white p-5 shadow-sm">
        <div class="mb-3 flex items-center justify-between">
          <h2 class="text-[15px] font-medium">待导出内容</h2>
          <button id="files-clear" class="rounded-lg border border-red-200 px-3 py-1 text-xs text-red-500 transition hover:bg-red-50">清空清单</button>
        </div>
        <div
          id="dropzone"
          class="mb-3 rounded-lg border-2 border-dashed border-[#D1D5DB] bg-[#F6F7FB] px-4 py-8 text-center transition hover:border-indigo-400 hover:bg-indigo-50/40"
        >
          <p class="text-sm text-[#6B7280]">拖拽文件到此处，或</p>
          <div class="mt-2 flex items-center justify-center gap-2">
            <button id="pick-files" class="rounded-lg border border-indigo-200 bg-indigo-50 px-3 py-1.5 text-xs font-medium text-indigo-600 transition hover:bg-indigo-100">选择文件</button>
            <button id="paste-text" class="rounded-lg border border-[#E5E7EB] px-3 py-1.5 text-xs text-[#374151] transition hover:bg-[#F6F7FB]">粘贴文本</button>
          </div>
          <input id="file-input" type="file" multiple class="hidden" />
          <p class="mt-2 text-[11px] text-[#9CA3AF]">内容自动分块传输（每请求 ≤10KB，适配公司网关） · 单批建议 ≤60 个文件 / ≤10MB</p>
        </div>
        <div id="paste-panel" class="mb-3 hidden rounded-lg border border-[#E5E7EB] bg-[#F6F7FB] p-3">
          <input id="paste-name" type="text" placeholder="文件名（如 notes.md）" class="mb-2 w-full rounded-lg border border-[#E5E7EB] bg-white px-3 py-1.5 text-sm outline-none focus:border-indigo-400" />
          <textarea id="paste-content" rows="5" placeholder="粘贴 LaTeX / CSV / 代码文本…" class="mb-2 w-full rounded-lg border border-[#E5E7EB] bg-white px-3 py-2 font-mono text-xs outline-none focus:border-indigo-400"></textarea>
          <div class="flex gap-2">
            <button id="paste-add" class="rounded-lg bg-indigo-600 px-3 py-1.5 text-xs font-medium text-white transition hover:opacity-90">加入清单</button>
            <button id="paste-cancel" class="rounded-lg border border-[#E5E7EB] bg-white px-3 py-1.5 text-xs text-[#6B7280] transition hover:bg-[#F6F7FB]">取消</button>
          </div>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="text-[#6B7280]">
              <tr class="border-b border-[#E5E7EB]">
                <th class="py-2 pr-2 font-medium">路径</th>
                <th class="py-2 pr-2 font-medium">大小</th>
                <th class="py-2 pr-2 font-medium">类型</th>
                <th class="py-2 pr-2 font-medium">进度</th>
                <th class="py-2 font-medium">状态</th>
              </tr>
            </thead>
            <tbody id="files-tbody"></tbody>
          </table>
        </div>
      </section>

      <!-- 4) 传输控制 -->
      <section id="transfer-card" class="hidden rounded-xl border border-[#E5E7EB] bg-white p-5 shadow-sm">
        <div class="mb-3 flex items-center justify-between">
          <h2 class="text-[15px] font-medium">传输与落盘</h2>
          <div class="flex gap-2">
            <button id="pause-btn" class="hidden rounded-lg border border-[#E5E7EB] px-3 py-1 text-xs text-[#374151] transition hover:bg-[#F6F7FB]">暂停</button>
            <button id="start-transfer" class="rounded-lg bg-gradient-to-r from-indigo-600 to-indigo-500 px-4 py-1.5 text-xs font-medium text-white shadow-sm transition hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50">
              开始传输并落盘
            </button>
          </div>
        </div>
        <div class="mb-1 flex items-center justify-between text-xs text-[#6B7280]">
          <span>总体进度</span>
          <span id="progress-text">0%</span>
        </div>
        <div class="mb-4 h-2 overflow-hidden rounded-full bg-[#EDEEF4]">
          <div id="progress-bar" class="h-full w-0 rounded-full bg-gradient-to-r from-indigo-600 via-indigo-500 to-cyan-400 transition-all duration-300"></div>
        </div>
        <div id="log-area" class="h-40 overflow-y-auto rounded-lg border border-[#E5E7EB] bg-[#0F172A] p-3 font-mono text-[11px] leading-relaxed text-slate-300"></div>
      </section>

      <!-- 5) 完成结果 -->
      <section id="result-card" class="hidden rounded-xl border border-[#E5E7EB] bg-white p-5 shadow-sm">
        <div id="result-ok" class="hidden">
          <div class="mb-3 flex items-center gap-2">
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-emerald-100 text-emerald-600">✓</span>
            <h2 class="text-[15px] font-medium">导出完成</h2>
          </div>
          <p class="mb-2 text-xs text-[#6B7280]">整批已作为单个 commit 写入 GitHub，中转暂存已清理：</p>
          <a id="commit-link" href="#" target="_blank" rel="noopener noreferrer" class="mb-3 inline-flex items-center gap-1.5 rounded-lg bg-gradient-to-r from-indigo-600 to-cyan-500 px-4 py-2 text-sm font-medium text-white shadow-sm transition hover:opacity-90">
            查看 GitHub Commit
          </a>
          <pre id="result-summary" class="overflow-x-auto rounded-lg bg-[#F6F7FB] p-3 font-mono text-[11px] leading-relaxed text-[#374151]"></pre>
          <button id="copy-summary" class="mt-3 rounded-lg border border-[#E5E7EB] px-3 py-1.5 text-xs text-[#374151] transition hover:bg-[#F6F7FB]">复制摘要</button>
        </div>
        <div id="result-fail" class="hidden">
          <div class="mb-2 flex items-center gap-2">
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-red-100 text-sm text-red-500">✕</span>
            <h2 class="text-[15px] font-medium">传输未完成</h2>
          </div>
          <p id="fail-reason" class="mb-3 rounded-lg bg-red-50 px-3 py-2 text-xs leading-relaxed text-red-600"></p>
          <button id="retry-finalize" class="rounded-lg border border-indigo-200 bg-indigo-50 px-3 py-1.5 text-xs font-medium text-indigo-600 transition hover:bg-indigo-100">重试落盘（finalize）</button>
        </div>
      </section>
    </main>

    <footer class="mx-auto max-w-3xl px-4 pb-8 text-center text-[11px] text-[#9CA3AF]">
      传输内容仅作瞬时中转，成功写入 GitHub 后即从暂存清除 · 请勿借此通道传输密钥或涉密材料
    </footer>

    <script is:inline define:vars={{ PASSWORD_HASH, DEFAULT_OWNER, DEFAULT_BRANCH, CONFIGURED }}>
      // ── 工具 ──
      const $ = (id) => document.getElementById(id);
      const setText = (id, t) => {
        const el = $(id);
        if (el) el.textContent = t;
      };
      async function sha256Hex(str) {
        const buf = new TextEncoder().encode(str);
        const digest = await crypto.subtle.digest("SHA-256", buf);
        return Array.from(new Uint8Array(digest)).map((b) => b.toString(16).padStart(2, "0")).join("");
      }
      async function sha256Bytes(bytes) {
        const digest = await crypto.subtle.digest("SHA-256", bytes);
        return Array.from(new Uint8Array(digest)).map((b) => b.toString(16).padStart(2, "0")).join("");
      }
      function bytesToBase64(bytes) {
        let bin = "";
        const STEP = 0x8000;
        for (let i = 0; i < bytes.length; i += STEP) {
          bin += String.fromCharCode.apply(null, bytes.subarray(i, i + STEP));
        }
        return btoa(bin);
      }
      const fmtSize = (n) => (n < 1024 ? `${n} B` : n < 1048576 ? `${(n / 1024).toFixed(1)} KB` : `${(n / 1048576).toFixed(1)} MB`);
      function log(level, msg) {
        const area = $("log-area");
        if (!area) return;
        const colors = { info: "text-slate-300", ok: "text-emerald-400", warn: "text-amber-400", error: "text-red-400" };
        const line = document.createElement("div");
        line.className = colors[level] || "text-slate-300";
        line.textContent = `[${new Date().toTimeString().slice(0, 8)}] ${msg}`;
        area.appendChild(line);
        area.scrollTop = area.scrollHeight;
      }

      // ── 状态 ──
      // 公司网关对请求体实测上限约 10KB（10240B），每块 body（meta 行+正文）必须低于此值
      const TEXT_CHUNK_CHARS = 3000; // 文本块字符数：最坏 3 字节/字符 → 9KB UTF-8 + meta 行 ≈ 9.5KB
      const CHUNK_RAW = 6750; // 二进制块原始字节数：3 的倍数，base64 后 9000 字符 + meta 行 ≈ 9.5KB
      let webToken = ""; // sha256(口令) = PUBLIC_EXPORT_PASSWORD_HASH
      let session = null; // { batch, owner, repo, branch, subdir, label }
      let entries = []; // { path, size, bytes:Uint8Array, text:string|null, binary, sha256, status, sentChunks:Set, totalChunks }
      let transferring = false;
      let paused = false;

      // ── 密码门 ──
      const gateCard = $("gate-card");
      if (!CONFIGURED) {
        if (gateCard) gateCard.classList.add("hidden");
      }
      async function tryUnlock() {
        const input = $("gate-password");
        const err = $("gate-error");
        if (!input || !gateCard) return;
        const hash = await sha256Hex(input.value);
        if (hash === PASSWORD_HASH) {
          webToken = PASSWORD_HASH;
          gateCard.classList.add("hidden");
          const sc = $("session-card");
          if (sc) sc.classList.remove("hidden");
          const ownerInput = $("f-owner");
          if (ownerInput && DEFAULT_OWNER && !ownerInput.value) ownerInput.value = DEFAULT_OWNER;
          const branchInput = $("f-branch");
          if (branchInput && !branchInput.value) branchInput.value = DEFAULT_BRANCH;
          setText("status-text", "已解锁");
        } else {
          if (err) {
            err.classList.remove("hidden");
            gateCard.classList.remove("shake");
            void gateCard.offsetWidth;
            gateCard.classList.add("shake");
          }
        }
      }
      const gateSubmit = $("gate-submit");
      if (gateSubmit) gateSubmit.addEventListener("click", tryUnlock);
      const gateInput = $("gate-password");
      if (gateInput)
        gateInput.addEventListener("keydown", (e) => {
          if (e.key === "Enter") tryUnlock();
        });

      // ── 会话 ──
      const startBtn = $("session-start");
      if (startBtn)
        startBtn.addEventListener("click", () => {
          const owner = ($("f-owner")?.value || "").trim();
          const repo = ($("f-repo")?.value || "").trim();
          const branch = ($("f-branch")?.value || "").trim() || "main";
          const subdir = ($("f-subdir")?.value || "").trim().replace(/^\/+|\/+$/g, "");
          const label = ($("f-label")?.value || "").trim();
          if (!/^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$/.test(owner) || !/^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$/.test(repo)) {
            alert("owner / 仓库名格式不合法（字母数字与 . _ -）");
            return;
          }
          session = {
            batch: `exp-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 6)}`,
            owner,
            repo,
            branch,
            subdir,
            label,
          };
          const hint = $("session-hint");
          if (hint) {
            hint.textContent = `批次 ${session.batch} → ${owner}/${repo} @ ${branch}${subdir ? " / " + subdir : ""}`;
            hint.classList.remove("hidden");
          }
          $("files-card")?.classList.remove("hidden");
          $("transfer-card")?.classList.remove("hidden");
          startBtn.disabled = true;
          startBtn.textContent = "会话已建立";
          log("info", `会话建立：${owner}/${repo} @ ${branch}（批次 ${session.batch}）`);
        });

      // ── 添加文件 ──
      async function addFile(file) {
        const relPath = file.webkitRelativePath && file.webkitRelativePath.length > 0 ? file.webkitRelativePath : file.name;
        const buf = new Uint8Array(await file.arrayBuffer());
        await addBytes(relPath, buf);
      }
      async function addBytes(path, bytes) {
        // UTF-8 fatal 探测：合法 → 文本分块直传；非法 → 二进制 base64 分块
        let text = null;
        try {
          text = new TextDecoder("utf-8", { fatal: true }).decode(bytes);
        } catch {
          text = null;
        }
        const binary = text === null;
        const totalChunks = binary
          ? Math.max(1, Math.ceil(bytes.length / CHUNK_RAW))
          : Math.max(1, Math.ceil(text.length / TEXT_CHUNK_CHARS));
        const sha = await sha256Bytes(bytes);
        entries.push({
          path,
          size: bytes.length,
          bytes,
          text,
          binary,
          sha256: sha,
          status: "pending",
          sentChunks: new Set(),
          totalChunks,
        });
        renderFiles();
        log("info", `已加入 ${path}（${fmtSize(bytes.length)}，${binary ? "base64" : "文本"}分块 ×${totalChunks}）`);
      }
      function typeBadge(e) {
        const ext = e.path.split(".").pop()?.toLowerCase() || "";
        const map = {
          tex: ["TeX", "bg-indigo-100 text-indigo-600"],
          csv: ["CSV", "bg-emerald-100 text-emerald-600"],
          py: ["代码", "bg-blue-100 text-blue-600"],
          mjs: ["代码", "bg-blue-100 text-blue-600"],
          js: ["代码", "bg-blue-100 text-blue-600"],
        };
        const hit = map[ext];
        if (hit) return `<span class="rounded px-1.5 py-0.5 text-[10px] font-medium ${hit[1]}">${hit[0]}</span>`;
        return e.binary
          ? `<span class="rounded bg-amber-100 px-1.5 py-0.5 text-[10px] font-medium text-amber-600">二进制</span>`
          : `<span class="rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-medium text-slate-500">文本</span>`;
      }
      function renderFiles() {
        const tbody = $("files-tbody");
        if (!tbody) return;
        tbody.innerHTML = entries
          .map((e, i) => {
            const dot = { pending: "bg-slate-300", sending: "bg-blue-400 pulse-dot", done: "bg-emerald-500", failed: "bg-red-500" }[e.status] || "bg-slate-300";
            const pct = e.totalChunks ? Math.round((e.sentChunks.size / e.totalChunks) * 100) : 0;
            return `<tr class="border-b border-[#F3F4F6] last:border-0">
              <td class="max-w-[220px] truncate py-2 pr-2 font-mono text-[11px]" title="${e.path}">${e.path}</td>
              <td class="py-2 pr-2 whitespace-nowrap">${fmtSize(e.size)}</td>
              <td class="py-2 pr-2">${typeBadge(e)}</td>
              <td class="py-2 pr-2"><div class="h-1.5 w-20 overflow-hidden rounded-full bg-[#EDEEF4]"><div class="h-full rounded-full bg-indigo-500 transition-all duration-300" style="width:${pct}%"></div></div></td>
              <td class="py-2"><span class="inline-flex items-center gap-1"><span class="h-1.5 w-1.5 rounded-full ${dot}"></span>${e.status}</span></td>
              <td class="py-2 text-right"><button data-rm="${i}" class="text-[#9CA3AF] transition hover:text-red-500" title="移除">✕</button></td>
            </tr>`;
          })
          .join("");
        tbody.querySelectorAll("button[data-rm]").forEach((btn) =>
          btn.addEventListener("click", () => {
            if (transferring) return;
            const i = Number(btn.getAttribute("data-rm"));
            entries.splice(i, 1);
            renderFiles();
          })
        );
      }
      const pickBtn = $("pick-files");
      const fileInput = $("file-input");
      if (pickBtn && fileInput) {
        pickBtn.addEventListener("click", () => fileInput.click());
        fileInput.addEventListener("change", async () => {
          for (const f of Array.from(fileInput.files || [])) await addFile(f);
          fileInput.value = "";
        });
      }
      const dz = $("dropzone");
      if (dz) {
        ["dragenter", "dragover"].forEach((ev) =>
          dz.addEventListener(ev, (e) => {
            e.preventDefault();
            dz.classList.add("border-indigo-400", "bg-indigo-50/40");
          })
        );
        ["dragleave", "drop"].forEach((ev) =>
          dz.addEventListener(ev, (e) => {
            e.preventDefault();
            dz.classList.remove("border-indigo-400", "bg-indigo-50/40");
          })
        );
        dz.addEventListener("drop", async (e) => {
          const files = e.dataTransfer?.files;
          if (!files) return;
          for (const f of Array.from(files)) await addFile(f);
        });
      }
      // 粘贴文本
      const pasteBtn = $("paste-text");
      if (pasteBtn)
        pasteBtn.addEventListener("click", () => {
          $("paste-panel")?.classList.remove("hidden");
        });
      const pasteCancel = $("paste-cancel");
      if (pasteCancel)
        pasteCancel.addEventListener("click", () => {
          $("paste-panel")?.classList.add("hidden");
        });
      const pasteAdd = $("paste-add");
      if (pasteAdd)
        pasteAdd.addEventListener("click", async () => {
          const content = ($("paste-content")?.value || "");
          if (!content.trim()) return;
          let name = ($("paste-name")?.value || "").trim();
          if (!name) name = `pasted-${Date.now()}.txt`;
          if (content.length > 2 * 1024 * 1024) {
            alert("粘贴文本超过 2MB，建议改用文件方式添加");
            return;
          }
          await addBytes(name, new TextEncoder().encode(content));
          if ($("paste-content")) $("paste-content").value = "";
          if ($("paste-name")) $("paste-name").value = "";
          $("paste-panel")?.classList.add("hidden");
        });
      const clearBtn = $("files-clear");
      if (clearBtn)
        clearBtn.addEventListener("click", () => {
          if (transferring) return;
          entries = [];
          renderFiles();
        });

      // ── 上传协议 ──
      async function postRelay(endpoint, meta, payload, useSecretHeader) {
        const headers = { "Content-Type": "text/plain" };
        if (useSecretHeader) headers["X-Relay-Secret"] = meta.__secret || "";
        const bodyMeta = { ...meta };
        delete bodyMeta.__secret;
        const body = `${JSON.stringify(bodyMeta)}\n${payload ?? ""}`;
        const res = await fetch(`/api/export/${endpoint}`, { method: "POST", headers, body });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.message || data.error || `HTTP ${res.status}`);
        return data;
      }
      async function queryBatch(batch) {
        const res = await fetch(`/api/export/upload?batch=${encodeURIComponent(batch)}&token=${encodeURIComponent(webToken)}`);
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.message || data.error || `HTTP ${res.status}`);
        return data;
      }

      function chunkMeta(entry, idx) {
        return {
          v: 1,
          action: "upload",
          batch: session.batch,
          repo_owner: session.owner,
          repo_name: session.repo,
          branch: session.branch,
          subdir: session.subdir,
          label: session.label,
          file_path: entry.path,
          is_binary: entry.binary,
          idx,
          total: entry.totalChunks,
          bytes: entry.size,
          file_sha256: entry.sha256,
          web_token: webToken,
        };
      }

      async function uploadEntry(entry) {
        entry.status = "sending";
        renderFiles();
        // 小分块协议：文本按字符切、二进制按字节切 base64，每块 body（meta 行+正文）≤ ~9.5KB
        let lastRender = 0;
        for (let idx = 0; idx < entry.totalChunks; idx++) {
          while (paused) await new Promise((r) => setTimeout(r, 400));
          if (entry.sentChunks.has(idx)) continue;
          let payload;
          if (entry.binary) {
            const start = idx * CHUNK_RAW;
            const slice = entry.bytes.subarray(start, Math.min(start + CHUNK_RAW, entry.bytes.length));
            payload = bytesToBase64(slice);
          } else {
            payload = entry.text.slice(idx * TEXT_CHUNK_CHARS, (idx + 1) * TEXT_CHUNK_CHARS);
          }
          let attempt = 0;
          for (;;) {
            try {
              await postRelay("upload", chunkMeta(entry, idx), payload, false);
              break;
            } catch (err) {
              attempt += 1;
              if (attempt >= 3) throw err;
              log("warn", `${entry.path} 第 ${idx + 1}/${entry.totalChunks} 块失败，重试 ${attempt}/3：${err.message}`);
              await new Promise((r) => setTimeout(r, 1500 * attempt));
            }
          }
          entry.sentChunks.add(idx);
          updateProgress();
          // 小块多时表格重渲染按 200ms 节流
          if (Date.now() - lastRender > 200) {
            renderFiles();
            lastRender = Date.now();
          }
        }
        entry.status = "done";
        renderFiles();
        updateProgress();
      }

      let doneChunks = 0;
      function updateProgress() {
        const total = entries.reduce((s, e) => s + e.totalChunks, 0);
        const done = entries.reduce((s, e) => s + e.sentChunks.size, 0);
        doneChunks = done;
        const pct = total ? Math.round((done / total) * 100) : 0;
        const bar = $("progress-bar");
        if (bar) bar.style.width = `${pct}%`;
        setText("progress-text", `${pct}%（${done}/${total} 块）`);
      }

      // ── 主流程：断点查询 → 逐文件上传 → finalize ──
      const startTransfer = $("start-transfer");
      if (startTransfer)
        startTransfer.addEventListener("click", async () => {
          if (transferring || !session || !entries.length) return;
          transferring = true;
          startTransfer.disabled = true;
          const pauseBtn = $("pause-btn");
          if (pauseBtn) pauseBtn.classList.remove("hidden");
          setText("status-text", "传输中");
          try {
            // 断点续传：查已收分块，跳过已完成部分
            try {
              const st = await queryBatch(session.batch);
              for (const f of st.files || []) {
                const entry = entries.find((e) => e.path === f.file_path);
                if (entry && f.is_binary === entry.binary && f.total === entry.totalChunks) {
                  for (const idx of f.received || []) entry.sentChunks.add(idx);
                }
              }
              const skipped = entries.reduce((s, e) => s + e.sentChunks.size, 0);
              if (skipped > 0) log("info", `断点续传：服务端已有 ${skipped} 块，跳过`);
            } catch {
              log("info", "无历史批次，全新上传");
            }

            for (const entry of entries) {
              if (entry.status === "done") continue;
              await uploadEntry(entry);
              log("ok", `已上传 ${entry.path}`);
            }

            log("info", "上传完成，开始落盘（GitHub commit）…");
            const fin = await postRelay(
              "finalize",
              { v: 1, action: "finalize", batch: session.batch, web_token: webToken },
              "",
              false
            );
            showResult(fin);
            log("ok", `落盘成功：${fin.commit_sha}`);
            setText("status-text", "已完成");
          } catch (err) {
            log("error", `失败：${err.message}`);
            setText("status-text", "失败");
            showFailure(err.message);
          } finally {
            transferring = false;
            const pauseBtn2 = $("pause-btn");
            if (pauseBtn2) pauseBtn2.classList.add("hidden");
          }
        });

      const pauseBtn = $("pause-btn");
      if (pauseBtn)
        pauseBtn.addEventListener("click", () => {
          paused = !paused;
          pauseBtn.textContent = paused ? "继续" : "暂停";
          log("warn", paused ? "已暂停" : "已继续");
        });

      // ── 结果展示 ──
      function showResult(fin) {
        const card = $("result-card");
        if (!card) return;
        card.classList.remove("hidden");
        $("result-ok")?.classList.remove("hidden");
        $("result-fail")?.classList.add("hidden");
        const link = $("commit-link");
        if (link) {
          link.href = fin.html_url || "#";
          link.textContent = `查看 GitHub Commit${fin.commit_sha ? " · " + fin.commit_sha.slice(0, 7) : ""}`;
        }
        const summary = [
          `批次：${fin.batch}`,
          `仓库：${fin.repo} @ ${fin.branch}`,
          `Commit：${fin.commit_sha}`,
          `文件（${(fin.files || []).length} 个）：`,
          ...(fin.files || []).map((f) => `  ${f.path}  (${fmtSize(f.bytes)})`),
        ].join("\n");
        const pre = $("result-summary");
        if (pre) pre.textContent = summary;
        const copyBtn = $("copy-summary");
        if (copyBtn)
          copyBtn.onclick = async () => {
            try {
              await navigator.clipboard.writeText(`${summary}\n${fin.html_url || ""}`);
              copyBtn.textContent = "已复制";
              setTimeout(() => (copyBtn.textContent = "复制摘要"), 1500);
            } catch {
              copyBtn.textContent = "复制失败";
            }
          };
        card.scrollIntoView({ behavior: "smooth" });
      }
      function showFailure(reason) {
        const card = $("result-card");
        if (!card) return;
        card.classList.remove("hidden");
        $("result-ok")?.classList.add("hidden");
        $("result-fail")?.classList.remove("hidden");
        setText("fail-reason", reason);
        const retry = $("retry-finalize");
        if (retry)
          retry.onclick = async () => {
            if (!session) return;
            try {
              log("info", "重试落盘（finalize）…");
              const fin = await postRelay(
                "finalize",
                { v: 1, action: "finalize", batch: session.batch, web_token: webToken },
                "",
                false
              );
              showResult(fin);
              setText("status-text", "已完成");
            } catch (err) {
              setText("fail-reason", err.message);
              log("error", `重试失败：${err.message}`);
            }
          };
        card.scrollIntoView({ behavior: "smooth" });
      }
    </script>
  </body>
</html>
