---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
import indexRaw from "../../public/projects/_index.json?raw";

interface WeeklyReport {
  file: string;
  url: string;
  title: string;
  period: string;
  generatedAt: string;
  size: number;
  updatedAt: number;
  source: string;
}

// 构建时通过 Vite 内联读取，避免运行时文件路径在构建环境中失效
let reports: WeeklyReport[] = [];
try {
  reports = JSON.parse(indexRaw);
} catch {
  reports = [];
}

// 单页替换模式：只展示最新一份日报
const latest = reports[0] ?? null;

const formatDate = (timestamp: number) =>
  new Date(timestamp).toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  });
---

<Layout title={`项目总揽 | ${config.site.title}`}>
  <Header />
  <Breadcrumb />
  <Main pageTitle="项目总揽" pageDesc="每日项目进展日报 · 每晚自动更新">
    {
      latest ? (
        <div class="flex flex-col gap-4">
          <div
            class="border-border bg-card flex flex-wrap items-center justify-between gap-2 rounded-lg border p-4"
          >
            <div>
              <div class="text-lg font-bold">{latest.title}</div>
              <div class="text-muted-foreground mt-0.5 text-sm">
                生成时间：
                {latest.generatedAt || formatDate(latest.updatedAt)}
              </div>
            </div>
            <a
              href={latest.url}
              target="_blank"
              rel="noopener"
              class="text-accent text-sm hover:underline"
            >
              在新窗口打开 ↗
            </a>
          </div>

          <div class="border-border bg-card rounded-lg border p-2 sm:p-4">
            <iframe
              id="report-frame"
              src={latest.url}
              title={latest.title}
              class="w-full rounded-md border-0 bg-white"
              loading="eager"
            />
          </div>
        </div>
      ) : (
        <div class="border-border bg-card rounded-lg border p-8 text-center text-sm">
          暂无日报数据。请先运行
          <code class="bg-muted mx-1 rounded px-2 py-0.5">
            node scripts/sync-weekly.mjs
          </code>
          同步 weekly 目录。
        </div>
      )
    }
  </Main>
  <Footer />
</Layout>

<script>
  const frame = document.querySelector<HTMLIFrameElement>("#report-frame");

  function fitFrame() {
    if (!frame?.contentDocument) return;
    const doc = frame.contentDocument;
    frame.style.height = `${Math.max(doc.documentElement.scrollHeight, 640)}px`;
  }

  // iframe 内容加载后按内容高度自适应（同源可直接读取）
  frame?.addEventListener("load", fitFrame);
  document.addEventListener("astro:page-load", fitFrame);
</script>
